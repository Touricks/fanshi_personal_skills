[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "$server_pkg"
version = "0.1.0"
description = "FastMCP server wrapping $domain_name authenticated search."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "fastmcp>=0.2",
    "pydantic>=2",
    "httpx>=0.27",
# <<IF browser=playwright>>
    "playwright>=1.40",
# <<ENDIF>>
]

[project.scripts]
$server_pkg = "$server_pkg.server:main"

[tool.setuptools.packages.find]
where = ["src"]
