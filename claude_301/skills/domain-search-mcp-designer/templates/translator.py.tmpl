# Selected at scaffold time.
# <<IF translator=identity>>
TRANSLATOR: Translator = IdentityTranslator()
# <<ENDIF>>
# <<IF translator=dictionary>>
TRANSLATOR: Translator = DictionaryTranslator()
# <<ENDIF>>
# <<IF translator=llm>>
TRANSLATOR: Translator = LLMTranslator()
# <<ENDIF>>


def translate(query: str, target: str = "$primary_lang") -> str:
    """Top-level entrypoint used by server.py."""
    return TRANSLATOR.translate(query, target)
