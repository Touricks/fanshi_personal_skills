@mcp.tool()
async def search(query: str, limit: int = 10) -> List[SearchResult]:
    """Search $domain_name for `query`. The query is translated from English
    to $primary_lang before hitting the site. Returns at most `limit` hits
    as SearchResult objects (title, url, snippet, source_language,
    retrieved_at).

    The writeback tool depends on every hit having a stable url + title —
    do not replace SearchResult with an ad-hoc dict.
    """
    translated = translate(query)
    init_scratchpad(query=query, translated_query=translated, backend=BACKEND)
    raw = await _browser_search(translated, limit)
    return [SearchResult(**hit) for hit in raw[:limit]]


@mcp.tool()
