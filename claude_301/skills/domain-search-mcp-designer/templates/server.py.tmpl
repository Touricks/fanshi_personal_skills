    Verbatim excerpts longer than 125 characters are not permitted — callers
    should paraphrase or truncate. See
    reference/src/tools/WebFetchTool/prompt.ts:28-34.
    """
    # TODO: fetch via the selected browser backend and extract content.
    raise NotImplementedError


@mcp.tool()
async def summarize_to_file(
    query: str, target_path: str, source_url: str, source_title: str, body: str
) -> str:
    """Append a per-source summary to the scratchpad for `query`, then
    regenerate the aggregate report at `target_path`.

    `body` is the summary text for this single source. The aggregate report
    at `target_path` will contain a mandatory `## Sources` section listing
    every (url, title) pair — see writeback.py.
    """
    append_summary(
        query=query, source_url=source_url, source_title=source_title, body=body
    )
    out = write_report(query, target_path)
    return str(out)


def main() -> None:
    mcp.run()


if __name__ == "__main__":
    main()
