"""$domain_name search MCP server.

Exposes three tools:

  - search(query, limit)          -> list[SearchResult]
  - fetch_detail(url)             -> DetailResult
  - summarize_to_file(query,      -> path: str
                      target_path)

Auth model: the user's browser session supplies cookies. This server
does NOT perform login. See references/playwright-vs-claude-in-chrome.md
for the credential-storage surface (TODO for downstream developers).
"""

from __future__ import annotations

